{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env.example"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"],
      "env": ["NEXT_PUBLIC_*", "SENTRY_*"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["db:generate"]
    },
    "typecheck": {
      "dependsOn": ["db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"],
      "env": ["DATABASE_URL_TEST"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
