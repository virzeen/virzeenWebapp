// Virzeen database schema. Rules: docs/database/data-rules.md
// Money is Int paisa (fields end in `Paisa`). Ids are cuid2. Catalog is archived, never deleted. Orders are never deleted.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_DUE
  COD_COLLECTED
}

enum PaymentMethod {
  COD
  ESEWA
  KHALTI
}

enum ShippingZone {
  KATHMANDU_VALLEY
  OUTSIDE_VALLEY
}

enum OrderEventType {
  ORDER_STATUS
  PAYMENT_STATUS
  NOTE
}

enum PortfolioKind {
  CAMPAIGN
  LOOKBOOK
  COLLABORATION
}

/// How "Features that perform" is laid out on the product page (specs/product-page-v2.md). From `md`: THREE = three
/// across (two at md), THREE_TWO = groups of five, three portrait then two landscape, TWO = two across, FULL = one per
/// row, TALL_LEFT / TALL_RIGHT = groups of three with a tall picture left / right of two stacked ones, WIDE_TOP =
/// groups of three with one full width then two side by side, CUSTOM = the owner's rows (Product.featureRows).
enum FeatureLayout {
  THREE
  THREE_TWO
  TWO
  FULL
  TALL_LEFT
  TALL_RIGHT
  WIDE_TOP
  CUSTOM
}

/// What a size guide shows (specs/product-page-v2.md): CHART = a size table (clothing), PICTURE = one size chart
/// picture (accessories).
enum SizeGuideKind {
  CHART
  PICTURE
}

// ─────────────────── Accounts (Better Auth tables) ───────────────────
// Shape required by Better Auth; ids are generated as cuid2 by the auth config.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  role             Role        @default(CUSTOMER)
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  addresses        Address[]
  favourites       Favourite[]
  cart             Cart?
  orders           Order[]
  auditLogs        AuditLog[]
}

model Session {
  id              String    @id
  expiresAt       DateTime
  token           String    @unique
  ipAddress       String?
  userAgent       String?
  /// When an admin passed the TOTP step-up in this session (email OTP and Google sign-in don't ask for it).
  adminVerifiedAt DateTime?
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@index([secret])
}

// ───────────────────────────── Customers ─────────────────────────────

model Address {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  province  String
  district  String
  city      String
  street    String
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A product (and style) a customer saved with "Favourite" (specs/favourites.md). Deleted when removed.
model Favourite {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The style (variant color) saved; "" = a product without styles.
  color     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, color])
  @@index([userId, createdAt])
  @@index([productId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id         String    @id @default(cuid(2))
  slug       String    @unique
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([sortOrder])
}

model Collection {
  id          String    @id @default(cuid(2))
  slug        String    @unique
  name        String
  description String?
  isFeatured  Boolean   @default(false)
  archivedAt  DateTime?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isFeatured])
}

model Product {
  id                String             @id @default(cuid(2))
  /// Product number (the 0042 in style numbers like VZ0042-101), never reused. Products that existed before it were
  /// numbered in the order they were made (specs/product-editor-on-page.md).
  number            Int                @unique @default(autoincrement())
  slug              String             @unique
  name              String
  description       String
  care              String?
  seoDescription    String?
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Lowest active variant price, kept in sync by catalogService.saveProduct (used for sorting and cards).
  fromPricePaisa    Int                @default(0)
  /// Delivery charge for this product, already included in every variant's pricePaisa (owner decision
  /// 2026-09-28: customers see one price and free shipping). Kept so admin can edit the two parts separately.
  shippingPaisa     Int                @default(0)
  isPublished       Boolean            @default(false)
  publishedAt       DateTime?
  archivedAt        DateTime?
  /// "Benefits" bullets in the product details popup (specs/product-page.md).
  benefits          String[]           @default([])
  /// "Product details" bullets in the product details popup.
  details           String[]           @default([])
  /// "Country/Region of origin", e.g. "China" (new products start with "China").
  countryOfOrigin   String?
  /// Chart behind the product page's "Size guide" popup (specs/size-guides.md); null = no size guide.
  sizeGuideId       String?
  sizeGuide         SizeGuide?         @relation(fields: [sizeGuideId], references: [id], onDelete: Restrict)
  /// How "Features that perform" is laid out (specs/product-page-v2.md); existing products get THREE.
  featureLayout     FeatureLayout      @default(THREE)
  /// The Custom layout's rows, top to bottom (specs/product-page-v2.md): up to 9 of
  /// { count: 1-4; shape: "LANDSCAPE" | "PORTRAIT" }, validated by featureRowsSchema (@virzeen/validators) on save and
  /// by parseFeatureRows on read (invalid = no rows). Kept when another layout is picked, so Custom gets them back.
  featureRows       Json               @default("[]")
  images            ProductImage[]
  variants          ProductVariant[]
  styles            ProductStyle[]
  features          ProductFeature[]
  favourites        Favourite[]
  collections       Collection[]
  portfolioProjects PortfolioProject[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([categoryId])
  @@index([isPublished, archivedAt, publishedAt])
  @@index([fromPricePaisa])
  @@index([sizeGuideId])
}

model ProductImage {
  id        String   @id @default(cuid(2))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Cloudinary public id (or a /public path for local seed data).
  url       String
  alt       String
  /// The style (a variant `color`) this photo shows; null = shared by every style (specs/product-styles.md).
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

/// A style's number and "Colour shown" (specs/product-editor-on-page.md): one row per variant colour, or one with
/// color "" for a product without styles. Never deleted, so a style number is never reused.
model ProductStyle {
  id          String   @id @default(cuid(2))
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The style (a variant `color`); "" = a product without styles.
  color       String
  /// Style number, e.g. VZ0042-101: never changes (a rename keeps it) and is never reused.
  code        String   @unique
  /// "Colour shown" on the product page, e.g. "Black/White"; null = the style's name.
  colourShown String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, color])
  @@index([productId])
}

/// A size chart made once in admin and picked on products (specs/size-guides.md). Archived, never deleted.
model SizeGuide {
  id           String        @id @default(cuid(2))
  /// Admin label and the popup's subtitle, e.g. "Tops". Unique among guides that aren't archived.
  name         String
  intro        String?
  /// CHART = a size table (existing guides), PICTURE = one size chart picture (specs/product-page-v2.md).
  kind         SizeGuideKind @default(CHART)
  /// CHART: { columns: string[]; rows: { size: string; values: string[] }[] } in cm, validated by sizeChartSchema
  /// (@virzeen/validators) on save and by parseSizeChart on read. PICTURE: null (no table is stored).
  chart        Json?
  fitTips      String?
  /// "How to measure" tips, one per line.
  howToMeasure String[]      @default([])
  /// CHART: the how-to-measure picture (optional). PICTURE: the size chart picture (required). Cloudinary public id
  /// (or a /public path for local seed data).
  imageUrl     String?
  imageAlt     String?
  archivedAt   DateTime?
  products     Product[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([archivedAt])
}

/// "Features that perform" card on the product page (specs/product-page.md). Replaced on every product save.
model ProductFeature {
  id        String   @id @default(cuid(2))
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// Cloudinary public id (or a /public path for local seed data).
  imageUrl  String
  /// Picture description; made from "{product}, {title}" when the admin leaves it blank.
  imageAlt  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductVariant {
  id         String      @id @default(cuid(2))
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku        String      @unique
  size       String?
  color      String?
  /// What the customer pays for one unit: product price + the product's shippingPaisa, VAT included.
  pricePaisa Int
  stock      Int         @default(0)
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId, sortOrder])
  @@index([size])
  @@index([color])
}

// ───────────────────────────── Cart ─────────────────────────────

model Cart {
  id         String     @id @default(cuid(2))
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Random token stored in the guest's httpOnly cookie.
  guestToken String?    @unique
  expiresAt  DateTime
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([expiresAt])
}

model CartItem {
  id             String         @id @default(cuid(2))
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int
  /// Price when the line was added; checkout compares it with the current price (PRICE_CHANGED).
  unitPricePaisa Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ───────────────────────────── Orders ─────────────────────────────

model Order {
  id              String        @id @default(cuid(2))
  /// Human-facing number: VZ-YYMMDD-XXXX
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod
  subtotalPaisa   Int
  shippingPaisa   Int
  totalPaisa      Int
  shippingZone    ShippingZone
  /// Snapshot of the delivery address at purchase time.
  addressSnapshot Json
  /// Snapshot of the customer's email for order emails.
  customerEmail   String
  /// Online payments hold stock until this time (payment-policy.md §4).
  reservedUntil   DateTime?
  courierName     String?
  trackingNumber  String?
  cancelReason    String?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  items           OrderItem[]
  payments        Payment[]
  events          OrderEvent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([reservedUntil])
  @@index([createdAt])
}

model OrderItem {
  id             String         @id @default(cuid(2))
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName    String
  productSlug    String
  sku            String
  variantLabel   String
  imageUrl       String?
  unitPricePaisa Int
  quantity       Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id            String        @id @default(cuid(2))
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider      PaymentMethod
  /// eSewa transaction_uuid, Khalti pidx, or COD-<orderNumber>.
  providerRef   String        @unique
  attempt       Int           @default(1)
  amountPaisa   Int
  status        PaymentStatus
  /// eSewa ref_id / Khalti transaction_id once verified.
  providerTxnId String?
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  /// Last provider status or problem seen during verification (e.g. "AMOUNT_MISMATCH", "AMBIGUOUS").
  lastIssue     String?
  /// Set once the owner has been alerted about this payment (amount mismatch, ambiguous > 24h).
  flaggedAt     DateTime?
  rawResponse   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model OrderEvent {
  id        String         @id @default(cuid(2))
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type      OrderEventType
  from      String?
  to        String
  /// "system", "customer:<userId>", "admin:<userId>", "provider:esewa", "cron:reconcile"
  actor     String
  reason    String?
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
}

/// Daily counter behind order numbers (VZ-YYMMDD-XXXX).
model OrderNumberCounter {
  day   String @id
  value Int
}

// ───────────────────────────── Portfolio ─────────────────────────────

model PortfolioProject {
  id          String        @id @default(cuid(2))
  slug        String        @unique
  title       String
  kind        PortfolioKind
  summary     String
  /// Array of blocks validated by portfolioBlockSchema (@virzeen/validators).
  body        Json
  coverUrl    String
  coverAlt    String
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  sortOrder   Int           @default(0)
  archivedAt  DateTime?
  products    Product[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isPublished, archivedAt, sortOrder])
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id        String   @id @default(cuid(2))
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}
