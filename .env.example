# Virzeen environment variables. Names only + fake/local values. Never commit real secrets.
# Local: copy to apps/web/.env.local. Production: set in Railway variables.
# Validated at startup by apps/web/src/server/env-schema.ts (docs/architecture.md "Environment variables").
# The live site (production build on a real domain) refuses to start on http, Mailpit, the memory limiter or
# sandbox payment settings.

# ── Core ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://virzeen:virzeen@localhost:5434/virzeen
# Integration tests only (docker-compose creates it)
DATABASE_URL_TEST=postgresql://virzeen:virzeen@localhost:5434/virzeen_test

# ── Auth (Better Auth) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (optional locally: the Google button hides when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments ── sandbox values below are eSewa's public test credentials
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_STATUS_URL=https://rc.esewa.com.np
# Khalti sandbox: create a merchant account at https://test-admin.khalti.com to get a test secret key
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# Live site: your merchant ESEWA_PRODUCT_CODE/ESEWA_SECRET_KEY, ESEWA_BASE_URL=https://epay.esewa.com.np,
# ESEWA_STATUS_URL=https://esewa.com.np, KHALTI_BASE_URL=https://khalti.com/api/v2 and the live Khalti key.
# Leave a provider's keys empty to hide it (cash on delivery always works).
# Staging only: true lets a production build on a real domain use the sandbox above.
ALLOW_SANDBOX_PAYMENTS=false

# ── Images (Cloudinary) ── optional locally: admin uploads are disabled when empty
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email ── resend (default in production) or mailpit (default in development; docker compose inbox)
EMAIL_TRANSPORT=mailpit
RESEND_API_KEY=
# Order emails and alerts. Sign-in codes use EMAIL_FROM_AUTH (optional; empty = EMAIL_FROM).
# Addresses and setup: docs/runbooks/email-setup.md
EMAIL_FROM=Virzeen <no-reply@virzeen.com>
EMAIL_FROM_AUTH=Virzeen <verify@virzeen.com>
# Where customers' replies to site emails go (optional; a bare address). The footer says "Reply to this email".
EMAIL_REPLY_TO=sales@virzeen.com
MAILPIT_URL=http://localhost:8025
# Owner inbox for alerts (payment mismatches, stuck payments)
OWNER_ALERT_EMAIL=owner@virzeen.com

# ── Rate limiting ── upstash (default in production) or memory (default in development)
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Jobs & monitoring ──
CRON_SECRET=replace-with-a-long-random-string
SENTRY_DSN=
# true: every page shows "We'll be back soon" (503) — used while restoring a backup
MAINTENANCE_MODE=false

# ── Local seed only ──
SEED_ADMIN_EMAIL=admin@virzeen.local
